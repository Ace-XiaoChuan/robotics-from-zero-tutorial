<mujocoinclude>
  <worldbody>
    <body name="upper_arm" pos="0 0 0.3" childclass="arm">
      <joint name="shoulder" range="-1.5 1.5"/>
      <geom name="upper_visual" fromto="0 0 0 0.4 0 0" mass="1"/>
      <body name="forearm" pos="0.4 0 0">
        <joint name="elbow" range="-2 2"/>
        <geom name="forearm_visual" fromto="0 0 0 0.3 0 0" mass="0.5" rgba="0.85 0.55 0.25 1"/>
        <site name="tip" pos="0.3 0 0" size="0.035" rgba="0.85 0.2 0.2 1"/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <position name="shoulder_servo" joint="shoulder" kp="40" kv="8" gear="1"
              ctrllimited="true" ctrlrange="-1.5 1.5" forcelimited="true" forcerange="-8 8"/>
    <position name="elbow_servo" joint="elbow" kp="40" kv="8" gear="1"
              ctrllimited="true" ctrlrange="-2 2" forcelimited="true" forcerange="-8 8"/>
  </actuator>
  <sensor>
    <jointpos name="shoulder_position" joint="shoulder"/>
    <jointpos name="elbow_position" joint="elbow"/>
    <jointvel name="shoulder_velocity" joint="shoulder"/>
    <jointvel name="elbow_velocity" joint="elbow"/>
    <framepos name="tip_position" objtype="site" objname="tip"/>
  </sensor>
  <keyframe>
    <key name="home" qpos="0 0" ctrl="0 0"/>
  </keyframe>
</mujocoinclude>
